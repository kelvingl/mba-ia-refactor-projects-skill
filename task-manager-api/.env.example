# Obrigatório — a aplicação não sobe sem este valor
SECRET_KEY=

# Opcional — padrão: sqlite:///tasks.db (relativo ao diretório do projeto)
DATABASE_URL=sqlite:///tasks.db

# Opcional — 0 (prod) ou 1 (debug)
FLASK_DEBUG=0

# Opcional — credenciais SMTP para notificações por e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
