# obrigatório — a aplicação não sobe sem este valor
SECRET_KEY=

# opcional — padrão: sqlite:///tasks.db
DATABASE_URL=sqlite:///tasks.db

# opcional — padrão: 0 (produção). Use 1 apenas localmente
FLASK_DEBUG=0

# opcional — credenciais SMTP para envio de e-mail (NotificationService)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
